{
    "$schema": "https://opencode.ai/config.json",
    "agents": {
        "build": {
            "mode": "primary",
            "prompt": "Build according to @plan",
            "permission": {
                "edit": "allow",
                "bash": "allow"
            }
        },
        "plan":{
            "prompt": "Plan according to user's prompt and delegate to build agent",
            "permission": {
                "edit": "deny",
                "bash": "allow"
            }
        },
        "git-reviewer": {
            "mode": "subagent",
            "permission": {
                "git *": "allow"      
            }
        }
    }
}
